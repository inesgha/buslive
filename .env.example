# Copie ce fichier en « .env » puis adapte les valeurs.
# Ne versionne JAMAIS le fichier .env (il est dans .gitignore).

# --- PostgreSQL + PostGIS (docker-compose.yml) ---
POSTGRES_USER=buslive
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=buslive
POSTGRES_PORT=5432

# --- Adminer (optionnel, profil « tools ») ---
ADMINER_PORT=8080

# --- Chaîne de connexion utilisée par Prisma (phase 1) ---
DATABASE_URL=postgresql://buslive:change-moi@localhost:5432/buslive?schema=public
