# Refuse l'installation si la version de Node ne respecte pas "engines".
engine-strict=true
# Les scripts "pnpm run" utilisent un shell type bash intégré à pnpm, au lieu
# de cmd.exe sous Windows : mêmes guillemets et mêmes variables sur tous les OS.
shell-emulator=true
# Les versions exactes sont figées dans pnpm-lock.yaml ; ici on garde des
# plages "^" lisibles dans les package.json.
save-prefix=^
