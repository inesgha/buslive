// Schéma de la base BusLive.
// La connexion (DATABASE_URL) est définie dans prisma.config.ts.
//
// Convention : modèles et champs en camelCase côté TypeScript, tables et
// colonnes en snake_case côté PostgreSQL (@map / @@map). Les requêtes SQL brutes
// (PostGIS, phases 3+) restent ainsi lisibles, sans guillemets partout.

generator client {
  provider     = "prisma-client"
  // Client généré dans le code source (ignoré par git), régénéré par « pnpm install ».
  output       = "../src/generated/prisma"
  // NestJS tourne en CommonJS.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Rôles, du moins au plus privilégié. Doit rester identique à ROLES dans @buslive/shared.
enum Role {
  USER
  MODERATOR
  ADMIN
}

/// Langue de l'interface. Doit rester identique à LOCALES dans @buslive/shared.
enum Locale {
  fr
  ar
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  /// Toujours stocké nettoyé et en minuscules (voir EmailSchema).
  email               String    @unique
  /// Empreinte argon2id du mot de passe, jamais le mot de passe lui-même.
  passwordHash        String    @map("password_hash")
  displayName         String    @map("display_name")
  role                Role      @default(USER)
  locale              Locale    @default(fr)
  /// Format +216XXXXXXXX. Réservé à une future connexion par SMS.
  phone               String?   @unique
  /// Score de confiance (voir TRUST_RULES dans @buslive/shared), entre -100 et 1000.
  trustScore          Int       @default(0) @map("trust_score")
  /// Notification quand mes signalements sont confirmés ou démentis (phase 8).
  notifyReportOutcome Boolean   @default(true) @map("notify_report_outcome")
  /// Compte suspendu par un modérateur : connexion refusée, sessions révoquées.
  suspendedAt         DateTime? @map("suspended_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens     RefreshToken[]
  proposedLines     Line[]
  proposedStops     Stop[]
  liveSessions      LiveSession[]
  reports           Report[]
  reportVotes       ReportVote[]
  trustEvents       TrustEvent[]
  favoriteLines     FavoriteLine[]
  favoriteStops     FavoriteStop[]
  alerts            Alert[]
  pushDevices       PushDevice[]
  notifications     Notification[]
  rideOffers        RideOffer[]
  rideRequests      RideRequest[]
  rideFlags         RideFlag[]
  tripShares        TripShare[]
  moderationActions ModerationAction[]

  @@map("users")
}

/// Jetons de rafraîchissement. Seule leur empreinte SHA-256 est stockée.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  /// Tous les jetons issus d'une même connexion partagent la même famille.
  /// Si un jeton déjà utilisé est présenté à nouveau, toute la famille est révoquée.
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Jeton qui a remplacé celui-ci lors d'une rotation.
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Réseau de transport (phase 3) — inspiré du format standard GTFS, simplifié.
// ---------------------------------------------------------------------------

/// Cycle de vie des éléments proposables par les utilisateurs (lignes, arrêts).
/// L'API publique n'affiche que les éléments ACTIVE.
enum ModerationStatus {
  PENDING
  ACTIVE
  REJECTED
  ARCHIVED
}

enum LineType {
  URBAN
  SUBURBAN
  INTERCITY
}

/// Sens d'une ligne : aller (OUTBOUND) ou retour (INBOUND).
enum Direction {
  OUTBOUND
  INBOUND
}

/// Les 24 gouvernorats. Seuls les gouvernorats actifs sont visibles dans l'app.
model Governorate {
  id        String   @id @default(uuid()) @db.Uuid
  /// Code ISO 3166-2, ex. « TN-53 » pour Mahdia.
  code      String   @unique
  nameFr    String   @map("name_fr")
  nameAr    String   @map("name_ar")
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  localities     Locality[]
  lines          Line[]
  stops          Stop[]
  louageStations LouageStation[]

  @@map("governorates")
}

/// Ville ou délégation (Mahdia, Ksour Essef…).
model Locality {
  id            String @id @default(uuid()) @db.Uuid
  /// Identifiant stable et lisible, ex. « ksour-essef ».
  code          String @unique
  governorateId String @map("governorate_id") @db.Uuid
  nameFr        String @map("name_fr")
  nameAr        String @map("name_ar")

  governorate        Governorate     @relation(fields: [governorateId], references: [id], onDelete: Restrict)
  stops              Stop[]
  louageStations     LouageStation[]
  louageDestinations LouageRoute[]
  ridesFrom          RideOffer[]     @relation("RideFrom")
  ridesTo            RideOffer[]     @relation("RideTo")

  @@index([governorateId])
  @@map("localities")
}

/// Société de transport (ex. Société Régionale de Transport).
model Operator {
  id      String  @id @default(uuid()) @db.Uuid
  code    String  @unique
  name    String
  website String?

  lines Line[]

  @@map("operators")
}

model Line {
  id            String           @id @default(uuid()) @db.Uuid
  /// Numéro affiché sur le bus, unique dans un gouvernorat.
  code          String
  governorateId String           @map("governorate_id") @db.Uuid
  operatorId    String?          @map("operator_id") @db.Uuid
  nameFr        String           @map("name_fr")
  nameAr        String           @map("name_ar")
  type          LineType
  /// Couleur sur la carte, format « #RRGGBB ».
  color         String
  status        ModerationStatus @default(PENDING)
  /// Utilisateur qui a proposé la ligne (null pour les données importées).
  proposedById  String?          @map("proposed_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  governorate  Governorate              @relation(fields: [governorateId], references: [id], onDelete: Restrict)
  operator     Operator?                @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  proposedBy   User?                    @relation(fields: [proposedById], references: [id], onDelete: SetNull)
  directions   LineDirection[]
  liveSessions LiveSession[]
  reports      Report[]
  observations StopPassageObservation[]
  favoritedBy  FavoriteLine[]
  alerts       Alert[]

  @@unique([governorateId, code])
  @@index([status])
  @@map("lines")
}

/// Un sens de circulation d'une ligne, avec sa destination affichée et son tracé.
model LineDirection {
  id         String                                      @id @default(uuid()) @db.Uuid
  lineId     String                                      @map("line_id") @db.Uuid
  direction  Direction
  /// Destination affichée, ex. « vers Ksour Essef ».
  headsignFr String                                      @map("headsign_fr")
  headsignAr String                                      @map("headsign_ar")
  /// Tracé du parcours (PostGIS). Écrit et lu en SQL brut : Prisma ne gère pas ce type.
  shape      Unsupported("geography(LineString, 4326)")?

  line         Line                     @relation(fields: [lineId], references: [id], onDelete: Cascade)
  stops        LineStop[]
  departures   Departure[]
  liveSessions LiveSession[]
  reports      Report[]
  observations StopPassageObservation[]
  alerts       Alert[]

  @@unique([lineId, direction])
  @@map("line_directions")
}

model Stop {
  id              String                                 @id @default(uuid()) @db.Uuid
  /// Identifiant stable et lisible, ex. « mahdia-gare-routiere ».
  code            String                                 @unique
  governorateId   String                                 @map("governorate_id") @db.Uuid
  localityId      String?                                @map("locality_id") @db.Uuid
  nameFr          String                                 @map("name_fr")
  nameAr          String                                 @map("name_ar")
  latitude        Float
  longitude       Float
  /// Point PostGIS CALCULÉ par PostgreSQL à partir de latitude/longitude
  /// (trigger « stops_set_location », voir la migration « network »). Ne jamais
  /// l'écrire : il suffit de modifier latitude et longitude.
  location        Unsupported("geography(Point, 4326)")?
  status          ModerationStatus                       @default(PENDING)
  proposedById    String?                                @map("proposed_by_id") @db.Uuid
  /// Proposition d'un passager (phase 10) : lignes qui passent, selon lui (indication).
  proposedLineIds String[]                               @default([]) @map("proposed_line_ids") @db.Uuid
  /// Date de la décision d'un modérateur sur la proposition.
  reviewedAt      DateTime?                              @map("reviewed_at") @db.Timestamptz(3)
  createdAt       DateTime                               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(3)

  governorate  Governorate              @relation(fields: [governorateId], references: [id], onDelete: Restrict)
  locality     Locality?                @relation(fields: [localityId], references: [id], onDelete: SetNull)
  proposedBy   User?                    @relation(fields: [proposedById], references: [id], onDelete: SetNull)
  lineStops    LineStop[]
  reports      Report[]
  observations StopPassageObservation[]
  favoritedBy  FavoriteStop[]
  alerts       Alert[]
  tripShares   TripShare[]

  /// Index spatial : rend rapides les recherches « arrêts à moins de X mètres ».
  @@index([location], type: Gist)
  @@index([governorateId, status])
  @@map("stops")
}

/// Arrêts d'un sens, dans l'ordre, avec le temps de trajet depuis le départ.
model LineStop {
  directionId      String @map("direction_id") @db.Uuid
  /// Position dans le parcours : 1, 2, 3…
  sequence         Int
  stopId           String @map("stop_id") @db.Uuid
  /// Minutes entre le départ du terminus et le passage à cet arrêt.
  minutesFromStart Int    @map("minutes_from_start")

  direction LineDirection @relation(fields: [directionId], references: [id], onDelete: Cascade)
  stop      Stop          @relation(fields: [stopId], references: [id], onDelete: Restrict)

  @@id([directionId, sequence])
  @@index([stopId])
  @@map("line_stops")
}

/// Jours de circulation (semaine, samedi, Ramadan…), avec une période de validité facultative.
model ServiceCalendar {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique
  nameFr    String    @map("name_fr")
  nameAr    String    @map("name_ar")
  monday    Boolean   @default(false)
  tuesday   Boolean   @default(false)
  wednesday Boolean   @default(false)
  thursday  Boolean   @default(false)
  friday    Boolean   @default(false)
  saturday  Boolean   @default(false)
  sunday    Boolean   @default(false)
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  /// Si plusieurs calendriers s'appliquent le même jour à un même sens, celui
  /// de plus haute priorité l'emporte (ex. Ramadan = 10 remplace Semaine = 0).
  priority  Int       @default(0)

  departures Departure[]

  @@map("service_calendars")
}

/// Heure de départ du terminus, pour un sens et un calendrier.
model Departure {
  id               String @id @default(uuid()) @db.Uuid
  directionId      String @map("direction_id") @db.Uuid
  calendarId       String @map("calendar_id") @db.Uuid
  /// Minutes depuis minuit, heure de Tunis (450 = 07:30). Peut dépasser 1440 après minuit.
  departureMinutes Int    @map("departure_minutes")

  direction LineDirection   @relation(fields: [directionId], references: [id], onDelete: Cascade)
  calendar  ServiceCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([directionId, calendarId, departureMinutes])
  @@index([calendarId])
  @@map("departures")
}

// ---------------------------------------------------------------------------
// Partage de position « Je suis dans le bus » (phase 6)
// ---------------------------------------------------------------------------

enum LiveSessionStatus {
  ACTIVE
  ENDED
}

/// Pourquoi un partage s'est arrêté. Doit rester identique à LiveSessionEndReasonSchema (@buslive/shared).
enum LiveSessionEndReason {
  USER
  TERMINUS
  INACTIVE
  MAX_DURATION
  REPLACED
}

/// Un partage de position par un passager. Vie privée : on ne garde PAS
/// l'historique du trajet, seulement la dernière position acceptée.
model LiveSession {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  lineId            String                @map("line_id") @db.Uuid
  directionId       String                @map("direction_id") @db.Uuid
  status            LiveSessionStatus     @default(ACTIVE)
  endReason         LiveSessionEndReason? @map("end_reason")
  startedAt         DateTime              @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt           DateTime?             @map("ended_at") @db.Timestamptz(3)
  lastLatitude      Float?                @map("last_latitude")
  lastLongitude     Float?                @map("last_longitude")
  lastPositionAt    DateTime?             @map("last_position_at") @db.Timestamptz(3)
  acceptedPositions Int                   @default(0) @map("accepted_positions")
  rejectedPositions Int                   @default(0) @map("rejected_positions")

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  line       Line          @relation(fields: [lineId], references: [id], onDelete: Cascade)
  direction  LineDirection @relation(fields: [directionId], references: [id], onDelete: Cascade)
  tripShares TripShare[]

  @@index([userId, status])
  @@index([lineId, status])
  @@map("live_sessions")
}

// ---------------------------------------------------------------------------
// Signalements, votes, confiance et passages observés (phase 7)
// ---------------------------------------------------------------------------

/// Doit rester identique à REPORT_TYPES (@buslive/shared).
enum ReportType {
  NOT_CAME
  PASSED
  FULL
  DELAYED
  BREAKDOWN
  STOP_MOVED
}

/// Doit rester identique à REPORT_STATUSES (@buslive/shared).
enum ReportStatus {
  ACTIVE
  CONFIRMED
  REJECTED
  EXPIRED
}

enum VoteValue {
  CONFIRM
  DENY
}

/// USER : vote d'un passager ; LIVE : preuve automatique (bus en direct observé).
enum VoteSource {
  USER
  LIVE
}

/// Doit rester identique à TRUST_EVENT_REASONS (@buslive/shared).
enum TrustEventReason {
  REPORT_CONFIRMED
  REPORT_REJECTED
  VOTE_CORRECT
  VOTE_WRONG
  SHARING_COMPLETED
  STOP_APPROVED
}

/// Signalement d'un passager. Pas de texte libre (rien à modérer).
model Report {
  id                     String       @id @default(uuid()) @db.Uuid
  userId                 String       @map("user_id") @db.Uuid
  type                   ReportType
  status                 ReportStatus @default(ACTIVE)
  lineId                 String       @map("line_id") @db.Uuid
  directionId            String?      @map("direction_id") @db.Uuid
  stopId                 String?      @map("stop_id") @db.Uuid
  /// Horaire concerné (« le bus de 07:30 ») : journée de service + minutes.
  serviceDate            DateTime?    @map("service_date") @db.Date
  scheduledMinutes       Int?         @map("scheduled_minutes")
  delayMinutes           Int?         @map("delay_minutes")
  /// Distance de l'auteur à l'arrêt au moment du signalement (m, arrondie).
  /// Sa position elle-même n'est pas conservée.
  reporterDistanceMeters Int?         @map("reporter_distance_meters")
  /// « Arrêt déplacé » : position proposée pour l'arrêt (à valider par un modérateur).
  proposedLatitude       Float?       @map("proposed_latitude")
  proposedLongitude      Float?       @map("proposed_longitude")
  /// Poids cumulés « pour » (auteur compris) et « contre ».
  confirmWeight          Float        @map("confirm_weight")
  denyWeight             Float        @default(0) @map("deny_weight")
  /// Votes d'autres passagers (l'auteur n'est pas compté).
  confirmCount           Int          @default(0) @map("confirm_count")
  denyCount              Int          @default(0) @map("deny_count")
  /// Auteur au score très bas : caché tant que le signalement n'est pas confirmé.
  hidden                 Boolean      @default(false)
  expiresAt              DateTime     @map("expires_at") @db.Timestamptz(3)
  resolvedAt             DateTime?    @map("resolved_at") @db.Timestamptz(3)
  /// « Arrêt déplacé » examiné par un modérateur (appliqué ou classé).
  moderatedAt            DateTime?    @map("moderated_at") @db.Timestamptz(3)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  line      Line           @relation(fields: [lineId], references: [id], onDelete: Cascade)
  direction LineDirection? @relation(fields: [directionId], references: [id], onDelete: Cascade)
  stop      Stop?          @relation(fields: [stopId], references: [id], onDelete: Cascade)
  votes     ReportVote[]
  events    TrustEvent[]

  @@index([lineId, status])
  @@index([stopId, status])
  @@index([status, expiresAt])
  @@index([userId, createdAt])
  @@map("reports")
}

model ReportVote {
  id        String     @id @default(uuid()) @db.Uuid
  reportId  String     @map("report_id") @db.Uuid
  /// null pour une preuve automatique (source LIVE).
  userId    String?    @map("user_id") @db.Uuid
  source    VoteSource @default(USER)
  value     VoteValue
  /// Poids du votant au moment du vote.
  weight    Float
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Un seul vote par utilisateur et par signalement (plusieurs null autorisés).
  @@unique([reportId, userId])
  @@map("report_votes")
}

/// Historique des points de confiance : l'utilisateur voit pourquoi son score bouge.
model TrustEvent {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  delta     Int
  reason    TrustEventReason
  reportId  String?          @map("report_id") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  report Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("trust_events")
}

/// Passage RÉEL d'un bus à un arrêt, observé grâce au partage en direct.
/// Anonyme : aucun lien avec les passagers ni avec les partages.
model StopPassageObservation {
  id               String    @id @default(uuid()) @db.Uuid
  lineId           String    @map("line_id") @db.Uuid
  directionId      String    @map("direction_id") @db.Uuid
  stopId           String    @map("stop_id") @db.Uuid
  observedAt       DateTime  @map("observed_at") @db.Timestamptz(3)
  /// Horaire prévu le plus proche (s'il y en a un à ± 30 min) et retard calculé.
  serviceDate      DateTime? @map("service_date") @db.Date
  scheduledMinutes Int?      @map("scheduled_minutes")
  delayMinutes     Int?      @map("delay_minutes")

  line      Line          @relation(fields: [lineId], references: [id], onDelete: Cascade)
  direction LineDirection @relation(fields: [directionId], references: [id], onDelete: Cascade)
  stop      Stop          @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@index([lineId, observedAt])
  @@index([directionId, stopId, observedAt])
  @@map("stop_passage_observations")
}

// ---------------------------------------------------------------------------
// Favoris, alertes et notifications push (phase 8)
// ---------------------------------------------------------------------------

/// Doit rester identique à PUSH_PLATFORMS (@buslive/shared).
enum PushPlatform {
  ANDROID
  IOS
}

/// Doit rester identique à NOTIFICATION_TYPES (@buslive/shared).
enum NotificationType {
  BUS_APPROACHING
  LINE_INCIDENT
  REPORT_RESOLVED
  TEST
  RIDE_REQUESTED
  RIDE_ACCEPTED
  RIDE_DECLINED
  RIDE_CANCELLED
  STOP_PROPOSAL_REVIEWED
}

model FavoriteLine {
  userId    String   @map("user_id") @db.Uuid
  lineId    String   @map("line_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  line Line @relation(fields: [lineId], references: [id], onDelete: Cascade)

  /// La clé primaire empêche les doublons.
  @@id([userId, lineId])
  @@map("favorite_lines")
}

model FavoriteStop {
  userId    String   @map("user_id") @db.Uuid
  stopId    String   @map("stop_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  stop Stop @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@id([userId, stopId])
  @@map("favorite_stops")
}

/// Alerte « mon trajet » : ligne, sens, arrêt et plage horaire (voir ALERT_RULES).
model Alert {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  lineId          String    @map("line_id") @db.Uuid
  directionId     String    @map("direction_id") @db.Uuid
  stopId          String    @map("stop_id") @db.Uuid
  /// Prévenir quand le bus arrive dans ce délai (minutes).
  leadMinutes     Int       @map("lead_minutes")
  /// Jours ISO 8601, triés : 1 = lundi … 7 = dimanche.
  days            Int[]
  /// Plage horaire, en minutes depuis minuit (heure de Tunis).
  startMinutes    Int       @map("start_minutes")
  endMinutes      Int       @map("end_minutes")
  notifyApproach  Boolean   @default(true) @map("notify_approach")
  notifyIncidents Boolean   @default(true) @map("notify_incidents")
  enabled         Boolean   @default(true)
  /// Dernière notification « bus qui approche » (anti-spam, voir approachCooldownMinutes).
  lastApproachAt  DateTime? @map("last_approach_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  line      Line          @relation(fields: [lineId], references: [id], onDelete: Cascade)
  direction LineDirection @relation(fields: [directionId], references: [id], onDelete: Cascade)
  stop      Stop          @relation(fields: [stopId], references: [id], onDelete: Cascade)

  /// Le moteur d'alertes cherche les alertes actives d'une ligne.
  @@index([lineId, enabled])
  @@index([userId])
  @@map("alerts")
}

/// Téléphone qui reçoit les notifications push (jeton FCM).
model PushDevice {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  /// Un jeton désigne un téléphone : s'il change de compte, la ligne change de propriétaire.
  token      String       @unique
  platform   PushPlatform
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Mis à jour à chaque ouverture de l'app : les appareils oubliés sont supprimés.
  lastSeenAt DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastSeenAt])
  @@map("push_devices")
}

/// Historique des notifications (onglet Alertes), gardé 30 jours.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  /// Données du contenu (voir NotificationContentSchema), validées avant écriture.
  data      Json
  /// Clé anti-doublon : la même notification n'est jamais créée deux fois
  /// pour un utilisateur (ex. « incident:<id du signalement> »).
  dedupeKey String           @map("dedupe_key")
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Alternatives (louage, covoiturage) et « Partager mon trajet » (phase 9)
// ---------------------------------------------------------------------------

/// Station de louage (taxis collectifs). Données de référence, modérées.
model LouageStation {
  id             String                                 @id @default(uuid()) @db.Uuid
  code           String                                 @unique
  governorateId  String                                 @map("governorate_id") @db.Uuid
  localityId     String?                                @map("locality_id") @db.Uuid
  nameFr         String                                 @map("name_fr")
  nameAr         String                                 @map("name_ar")
  latitude       Float
  longitude      Float
  /// Point PostGIS CALCULÉ par le trigger « louage_stations_set_location » (comme stops.location).
  location       Unsupported("geography(Point, 4326)")?
  /// Horaires d'ouverture, en minutes depuis minuit (heure de Tunis) ; null = inconnus.
  openingMinutes Int?                                   @map("opening_minutes")
  closingMinutes Int?                                   @map("closing_minutes")
  status         ModerationStatus                       @default(PENDING)
  createdAt      DateTime                               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(3)

  governorate Governorate   @relation(fields: [governorateId], references: [id], onDelete: Restrict)
  locality    Locality?     @relation(fields: [localityId], references: [id], onDelete: SetNull)
  routes      LouageRoute[]

  @@index([location], type: Gist)
  @@map("louage_stations")
}

/// Destination desservie depuis une station, avec le prix habituel d'une place.
model LouageRoute {
  id                    String @id @default(uuid()) @db.Uuid
  stationId             String @map("station_id") @db.Uuid
  destinationLocalityId String @map("destination_locality_id") @db.Uuid
  /// En millimes (1 DT = 1000 millimes).
  priceMillimes         Int    @map("price_millimes")
  durationMinutes       Int    @map("duration_minutes")

  station     LouageStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  destination Locality      @relation(fields: [destinationLocalityId], references: [id], onDelete: Restrict)

  @@unique([stationId, destinationLocalityId])
  @@index([destinationLocalityId])
  @@map("louage_routes")
}

/// Doit rester identique à RIDE_OFFER_STATUSES (@buslive/shared).
enum RideOfferStatus {
  ACTIVE
  CANCELLED
}

/// Doit rester identique à RIDE_REQUEST_STATUSES (@buslive/shared).
enum RideRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

/// Doit rester identique à RIDE_FLAG_REASONS (@buslive/shared).
enum RideFlagReason {
  FAKE
  UNSAFE
  INAPPROPRIATE
}

/// Trajet proposé par un conducteur. Pas de texte libre ; expire à l'heure de départ.
model RideOffer {
  id             String          @id @default(uuid()) @db.Uuid
  driverId       String          @map("driver_id") @db.Uuid
  fromLocalityId String          @map("from_locality_id") @db.Uuid
  toLocalityId   String          @map("to_locality_id") @db.Uuid
  departureAt    DateTime        @map("departure_at") @db.Timestamptz(3)
  seats          Int
  /// Participation par place, en millimes (réglée hors de l'app).
  priceMillimes  Int             @map("price_millimes")
  status         RideOfferStatus @default(ACTIVE)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  cancelledAt    DateTime?       @map("cancelled_at") @db.Timestamptz(3)

  driver   User          @relation(fields: [driverId], references: [id], onDelete: Cascade)
  from     Locality      @relation("RideFrom", fields: [fromLocalityId], references: [id], onDelete: Restrict)
  to       Locality      @relation("RideTo", fields: [toLocalityId], references: [id], onDelete: Restrict)
  requests RideRequest[]
  flags    RideFlag[]

  @@index([status, departureAt])
  @@index([driverId, status])
  @@map("ride_offers")
}

/// Demande de places d'un passager. Une seule par passager et par annonce.
model RideRequest {
  id          String            @id @default(uuid()) @db.Uuid
  offerId     String            @map("offer_id") @db.Uuid
  passengerId String            @map("passenger_id") @db.Uuid
  seats       Int
  status      RideRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  respondedAt DateTime?         @map("responded_at") @db.Timestamptz(3)

  offer     RideOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  passenger User      @relation(fields: [passengerId], references: [id], onDelete: Cascade)

  @@unique([offerId, passengerId])
  @@index([passengerId, createdAt])
  @@map("ride_requests")
}

/// Annonce signalée par un utilisateur (traitée par la modération, phase 10).
model RideFlag {
  id         String         @id @default(uuid()) @db.Uuid
  offerId    String         @map("offer_id") @db.Uuid
  reporterId String         @map("reporter_id") @db.Uuid
  reason     RideFlagReason
  /// Signalement traité par un modérateur.
  resolvedAt DateTime?      @map("resolved_at") @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  offer    RideOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  reporter User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([offerId, reporterId])
  @@map("ride_flags")
}

/// Lien « Partager mon trajet ». Seule l'EMPREINTE du jeton est gardée (comme
/// les refresh tokens) : une fuite de la base ne donne pas accès aux liens.
model TripShare {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  sessionId         String    @map("session_id") @db.Uuid
  destinationStopId String    @map("destination_stop_id") @db.Uuid
  /// SHA-256 du jeton, en hexadécimal.
  tokenHash         String    @unique @map("token_hash")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Le bus a atteint l'arrêt de descente.
  arrivedAt         DateTime? @map("arrived_at") @db.Timestamptz(3)

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session         LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  destinationStop Stop        @relation(fields: [destinationStopId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@map("trip_shares")
}

// ---------------------------------------------------------------------------
// Modération (phase 10)
// ---------------------------------------------------------------------------

/// Doit rester identique à MODERATION_ACTION_TYPES (@buslive/shared).
enum ModerationActionType {
  REPORT_CONFIRMED
  REPORT_REJECTED
  REPORT_HIDDEN
  STOP_MOVE_APPLIED
  STOP_MOVE_DISMISSED
  STOP_APPROVED
  STOP_REJECTED
  STOP_UPDATED
  RIDE_CANCELLED
  RIDE_FLAGS_DISMISSED
  USER_SUSPENDED
  USER_REINSTATED
  USER_ROLE_CHANGED
  GOVERNORATE_UPDATED
  LOUAGE_STATION_SAVED
  LOUAGE_STATION_ARCHIVED
}

/// Journal des actions de modération : JAMAIS modifié ni effacé par l'application.
model ModerationAction {
  id          String               @id @default(uuid()) @db.Uuid
  moderatorId String               @map("moderator_id") @db.Uuid
  type        ModerationActionType
  /// « report », « stop », « ride », « user », « governorate », « louage_station ».
  targetType  String               @map("target_type")
  targetId    String               @map("target_id")
  /// Valeurs avant / après.
  details     Json
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  /// Restrict : on ne peut pas supprimer un compte qui a modéré (le journal reste complet).
  moderator User @relation(fields: [moderatorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("moderation_actions")
}
