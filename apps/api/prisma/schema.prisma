// Schéma de la base BusLive.
// La connexion (DATABASE_URL) est définie dans prisma.config.ts.
//
// Convention : modèles et champs en camelCase côté TypeScript, tables et
// colonnes en snake_case côté PostgreSQL (@map / @@map). Les requêtes SQL brutes
// (PostGIS, phases 3+) restent ainsi lisibles, sans guillemets partout.

generator client {
  provider     = "prisma-client"
  // Client généré dans le code source (ignoré par git), régénéré par « pnpm install ».
  output       = "../src/generated/prisma"
  // NestJS tourne en CommonJS.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Rôles, du moins au plus privilégié. Doit rester identique à ROLES dans @buslive/shared.
enum Role {
  USER
  MODERATOR
  ADMIN
}

/// Langue de l'interface. Doit rester identique à LOCALES dans @buslive/shared.
enum Locale {
  fr
  ar
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  /// Toujours stocké nettoyé et en minuscules (voir EmailSchema).
  email        String   @unique
  /// Empreinte argon2id du mot de passe, jamais le mot de passe lui-même.
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  role         Role     @default(USER)
  locale       Locale   @default(fr)
  /// Format +216XXXXXXXX. Réservé à une future connexion par SMS.
  phone        String?  @unique
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens RefreshToken[]

  @@map("users")
}

/// Jetons de rafraîchissement. Seule leur empreinte SHA-256 est stockée.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  /// Tous les jetons issus d'une même connexion partagent la même famille.
  /// Si un jeton déjà utilisé est présenté à nouveau, toute la famille est révoquée.
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Jeton qui a remplacé celui-ci lors d'une rotation.
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
