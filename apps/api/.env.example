# Copie ce fichier en « apps/api/.env » puis adapte les valeurs.
# Ne versionne JAMAIS le fichier .env.

# development | test | production
NODE_ENV=development

# Port HTTP de l'API
PORT=3000

# Base PostgreSQL + PostGIS (mêmes identifiants que le .env racine de Docker).
# Si le mot de passe contient des caractères spéciaux (@ : / # ?…), encode-les
# (ex. « @ » → « %40 »).
DATABASE_URL=postgresql://buslive:change-moi@localhost:5432/buslive?schema=public

# Origines autorisées à appeler l'API depuis un navigateur, séparées par des virgules
# (5173 = admin Vite, 8081 = Expo web).
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Authentification ---
# Clé de signature des access tokens : au moins 32 caractères ALÉATOIRES.
# Pour en générer une :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-moi-change-moi-change-moi-change-moi
# Durée de vie d'un access token (secondes) et d'un refresh token (jours)
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- Limitation des requêtes (routes @RateLimit : /auth/login, /auth/register) ---
# Requêtes autorisées par adresse IP et par fenêtre, et durée de la fenêtre (secondes)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=60

# --- Temps réel ---
# Délai minimal entre deux diffusions des bus en direct d'une même ligne (ms)
LIVE_BROADCAST_INTERVAL_MS=3000

# --- Notifications push (phase 8) ---
# log    : les notifications sont seulement écrites dans la console de l'API
#          (développement : tout fonctionne sans compte Firebase) ;
# fcm    : envoi réel par Firebase Cloud Messaging ;
# memory : réservé aux tests automatiques.
PUSH_PROVIDER=log
# Avec PUSH_PROVIDER=fcm : chemin de la clé du compte de service Firebase
# (Console Firebase → Paramètres du projet → Comptes de service → Générer une
# nouvelle clé privée). Le dossier « secrets/ » est ignoré par git.
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
