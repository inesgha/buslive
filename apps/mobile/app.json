{
  "expo": {
    "name": "BusLive",
    "slug": "buslive",
    "scheme": "buslive",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tn.buslive.app"
    },
    "android": {
      "package": "tn.buslive.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFC52E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "supportedLocales": ["fr", "ar"]
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#FFC52E",
          "dark": {
            "backgroundColor": "#0E1B2C"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BusLive utilise ta position pour afficher les arrêts et les bus proches de toi.",
          "locationAlwaysAndWhenInUsePermission": "BusLive utilise ta position en arrière-plan uniquement pendant que tu partages la position d'un bus.",
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FFC52E",
          "defaultChannel": "account"
        }
      ]
    ]
  }
}
